<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.zygl.mapper.ResourceDetailMapper">

    <resultMap id="BaseResultMap" type="org.example.zygl.entity.ResourceDetail">
        <id column="pk_id" property="pkId"/>
        <result column="resource_id" property="resourceId"/>
        <result column="episode_no" property="episodeNo"/>
        <result column="resource_file_url" property="resourceFileUrl"/>
        <result column="episode_name" property="episodeName"/>
        <result column="resource_storage" property="resourceStorage"/>
        <result column="description" property="description"/>
        <result column="attachment_url" property="attachmentUrl"/>
        <result column="attachment_name" property="attachmentName"/>
        <result column="attachment_storage" property="attachmentStorage"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        pk_id, resource_id, episode_no, resource_file_url, episode_name, resource_storage,
        description, attachment_url, attachment_name, attachment_storage, tenant_id, deleted
    </sql>

    <select id="selectByResourceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM resource_detail
        WHERE deleted = 0
        AND resource_id = #{resourceId}
        ORDER BY episode_no ASC
    </select>

    <select id="selectPageByResourceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM resource_detail
        WHERE deleted = 0
        AND resource_id = #{resourceId}
        ORDER BY episode_no ASC
    </select>

</mapper>
