<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.zygl.mapper.PortalResourceCategoryMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="org.example.zygl.entity.PortalResourceCategory">
        <id column="pk_id" property="pkId"/>
        <result column="type_uid" property="typeUid"/>
        <result column="type_name" property="typeName"/>
        <result column="parent_id" property="parentId"/>
        <result column="level" property="level"/>
        <result column="path" property="path"/>
        <result column="type" property="type"/>
        <result column="order" property="order"/>
        <result column="status" property="status"/>
        <result column="creator" property="creator"/>
        <result column="create_time" property="createTime"/>
        <result column="updater" property="updater"/>
        <result column="update_time" property="updateTime"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用列 -->
    <sql id="Base_Column_List">
        pk_id, type_uid, type_name, parent_id, level, path, type, `order`, status,
        creator, create_time, updater, update_time, tenant_id, deleted
    </sql>

    <!-- 按资源类型查询 -->
    <select id="selectByType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM portal_resource_category
        WHERE deleted = 0
        <if test="type != null">
            AND type = #{type}
        </if>
        ORDER BY `order` ASC
    </select>

    <!-- 按父级ID查询子分类 -->
    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM portal_resource_category
        WHERE deleted = 0
        AND parent_id = #{parentId}
        ORDER BY `order` ASC
    </select>

    <!-- 按type_uid查询 -->
    <select id="selectByTypeUid" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM portal_resource_category
        WHERE deleted = 0
        AND type_uid = #{typeUid}
        LIMIT 1
    </select>

    <!-- 按名称模糊查询 -->
    <select id="selectByTypeName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM portal_resource_category
        WHERE deleted = 0
        <if test="typeName != null and typeName != ''">
            AND type_name LIKE CONCAT('%', #{typeName}, '%')
        </if>
        ORDER BY `order` ASC
    </select>

    <!-- 查询所有分类（用于树形组装） -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM portal_resource_category
        WHERE deleted = 0
        <if test="type != null">
            AND type = #{type}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY level ASC, `order` ASC
    </select>

    <!-- 统计指定分类下的子分类数量 -->
    <select id="countChildren" resultType="int">
        SELECT COUNT(*)
        FROM portal_resource_category
        WHERE deleted = 0
        AND parent_id = #{parentId}
    </select>

    <!-- 更新单个分类状态 -->
    <update id="updateStatus">
        UPDATE portal_resource_category
        SET status = #{status}, update_time = NOW()
        WHERE pk_id = #{id} AND deleted = 0
    </update>

    <!-- 条件分页查询 -->
    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM portal_resource_category
        WHERE deleted = 0
        <if test="type != null">
            AND type = #{type}
        </if>
        <if test="typeName != null and typeName != ''">
            AND type_name LIKE CONCAT('%', #{typeName}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY `order` ASC
    </select>

</mapper>
